# ---- Secrets (絶対にコミットしない) ----
# validator/staking 用 private key(metalgo の典型ファイル名)
*.priv*
staker.*
signer.*
# 一般的な秘密鍵 / 証明書(拡張子で識別、ドキュメントを誤って捕捉しない)
# 注意: macOS は case-insensitive FS なので `*key*` のような名前マッチは大文字も拾う → 拡張子のみで識別
*.key
*.pem
*.crt
*.cer
*.p12
*.pfx
*.jks
# operator identity ed25519 key (no extension → would not match *.key)
# The .pub goes into public/.well-known/operator-identity.pub via rename, not by this name.
freedom-yield-operator-identity
freedom-yield-operator-identity.pub
# 環境変数 / dotenv
.env
.env.*
!.env.example

# ---- ランタイム生成データ (秘密鍵を含む可能性) ----
# Caddy: 本番では Let's Encrypt の秘密鍵をここに書く
caddy/data/
caddy/config/
# metalgo: chain DB + staking key(本リポでは named volume を使うので普通は不要、bind mount にしたとき用)
metalgo/data/
metalgo/config/

# ---- OS / editor cruft ----
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# ---- Build / cache ----
node_modules/
dist/
.cache/
*.log
# Python (= scripts/ops/*.py, tests/ops/*.py)
__pycache__/
*.pyc

# ---- Runtime-generated site data ----
# api/validator.json は live metalgo から生成する動的データ(scripts/node-info.sh)
# schema は public/api/validator.example.json を参照
public/api/validator.json
# api/evidence.json は validator.json + 静的 config から日次生成(scripts/gen-evidence.sh)
# schema は public/api/evidence.example.json を参照
public/api/evidence.json
# uptime track record — validator host で生成 + push、ローカル開発時のみ
# placeholder を置くことがあるが、コミットはしない(動的データ)
public/api/uptime-recent.json
public/api/uptime-cycles.json
public/api/peer-geo.json
public/api/server-status.json
public/api/peers.json
# cycle-history.jsonl は uptime-cycles.json + incidents.json から join 生成(scripts/gen-cycle-history.sh)
# schema は public/api/cycle-history.example.jsonl を参照
public/api/cycle-history.jsonl
# fee-market 履歴 — validator host で生成 + push、 集計と append-only history
public/api/fee-market.json
public/api/fee-market-history.jsonl
# node-health 周期サンプリング — validator host で生成 + push
public/api/node-health-recent.json
# peers 動的解析 — validator host で生成 + push (Gini / 変動 / 履歴インデックス)
public/api/peers-changes.json
public/api/peers-gini.json
public/api/peers-gini-history.jsonl
public/api/peers-history-index.json
# calendar/*.ics は gen-renewal-ics.sh が生成、ファイル名に private token が
# 入るので絶対コミットしない(public 化前提リポ、token は private URL の要)
public/calendar/

# ---- Local-only artifacts ----
# CI/CD で deploy 時に生成、コミット不要
public/api/build.json
# ローカルの Claude Code 等の状態(誤コミット防止)
# ただし settings.json は tier-1 PreToolUse hook 定義 = repo で共有 mandatory
# (docs/CONSTITUTION.md PRIME DIRECTIVE + memory/project_broadcast_enforcement_gate_plan.md)
.claude/*
!.claude/settings.json
.local/

# ---- publish-guard local denylist ----
# scripts/publish-guard.sh が読む local-only の追加禁止文字列リスト。real host IP /
# operator handle / SSH key 名 等を含むので絶対に tracked にしない。雛形は
# .publish-denylist.example (tracked、secret なし)。built-in の IP regex + 埋め込み
# hash で大半は捕捉するので、この denylist は「取りこぼす追加 exact 文字列」用の任意層。
.publish-denylist
