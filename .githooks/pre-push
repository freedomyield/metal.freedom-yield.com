#!/usr/bin/env bash
# Pre-push hook: last line before PUBLICATION.
#
# Scans every commit range about to be pushed for forbidden host identifiers
# (real host IP / operator handle / SSH key name) via scripts/publish-guard.sh
# and ABORTS the push (exit 1) if any is found. This is the definitive
# "IP 掲載の直前に強制停止" layer requested after the 2026-07-03 leak:
# it fires no matter who runs `git push` (Claude, operator, another agent).
#
# 有効化: git config core.hooksPath .githooks  (既存設定を共有)
#
# stdin (per git): <local ref> <local sha> <remote ref> <remote sha>

set -uo pipefail

ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
GUARD="${ROOT}/scripts/publish-guard.sh"

# Fail-closed philosophy, but if the guard is absent we cannot scan; warn and
# allow rather than hard-break every push in a repo without the script.
if [[ ! -x "${GUARD}" ]]; then
	echo "pre-push: WARNING scripts/publish-guard.sh not executable; host-identifier scan skipped." >&2
	exit 0
fi

ZERO="0000000000000000000000000000000000000000"
BLOCKED=0

while read -r localref localsha remoteref remotesha; do
	# Deleting a remote ref: nothing to scan.
	[[ "${localsha}" == "${ZERO}" ]] && continue

	if [[ "${remotesha}" == "${ZERO}" ]]; then
		# New branch on the remote: scan against origin/main if known,
		# else scan the tip commit's own diff.
		base="$(git rev-parse --verify -q origin/main 2>/dev/null || true)"
		if [[ -n "${base}" ]]; then
			range="${base}..${localsha}"
		else
			range="${localsha}~1..${localsha}"
		fi
	else
		range="${remotesha}..${localsha}"
	fi

	if ! git diff "${range}" -U0 2>/dev/null | "${GUARD}" --diff; then
		echo "pre-push: forbidden host identifier detected in ${range} — PUSH ABORTED." >&2
		BLOCKED=1
	fi
done

if [[ "${BLOCKED}" -ne 0 ]]; then
	echo >&2
	echo "Push を中止しました。real host IP / operator handle / SSH key 名 を除去(RFC5737 dummy へ) してから再 push してください。" >&2
	echo "既に commit 済なら amend / filter-repo で history からも除去が必要です。--no-verify での回避は禁止です。" >&2
	exit 1
fi

exit 0
