# 本番デプロイ時は cp .env.example .env して値を埋める

# ---- 本番(VPS)で使う ----
# 公開ドメイン
DOMAIN=metal.freedom-yield.com
# Let's Encrypt のアカウント連絡先メール(証明書失効通知などが届く)
ACME_EMAIL=

# ---- ローカル開発で使う(任意) ----
# ホスト側で 8080 が埋まっているとき変更
# HTTP_PORT=18080

# ---- metalgo の compose 命名(任意。新 host では設定しない)----
# 未設定なら repo の既定: project=metalgo-stack / container=metalgo-${METAL_NETWORK}
#   / /data volume=<project>_metalgo_data
# repo より前から動いている host だけ、現行の名前に合わせて設定する。
# 設定後、compose で metalgo を作り直す前に必ず scripts/check-compose-naming.sh が
# RESULT: MATCH を返すことを確認する(不一致のまま up すると新しい空の volume
# = 新しい staker keys = 別 NodeID で起動する。docs/DISASTER_RECOVERY.md 冒頭の警告)
# COMPOSE_PROJECT_NAME は使わない(この .env を共有する Caddy の stack まで改名される)
# METALGO_COMPOSE_PROJECT=<current-project>
# METALGO_CONTAINER_NAME=<current-container>
