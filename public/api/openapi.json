{
  "openapi": "3.1.0",
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "info": {
    "title": "Metal Freedom Yield public data",
    "version": "1.0.0",
    "description": "Static files, GET only, free, no authentication. Public data files of Metal Freedom Yield, an independent validator on the Metal Blockchain mainnet. A plain-text guide is at https://metal.freedom-yield.com/llms.txt."
  },
  "servers": [
    {
      "url": "https://metal.freedom-yield.com"
    }
  ],
