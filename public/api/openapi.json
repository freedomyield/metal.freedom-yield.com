    "/api/validator.json": {
      "get": {
        "operationId": "get_validator_json",
        "summary": "validator.json",
        "description": "Live validator identity, stake, uptime%, and P/X/C-Chain bootstrap status. Updated every 5 minutes.",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "./validator.schema.v1.json"
                }
              }
            }
          }
        }
      },
      "head": {
        "operationId": "head_validator_json",
        "summary": "validator.json (headers only)",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
